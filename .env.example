# Port public on s'exposa nginx (80 en producció, 8080 en local)
WEB_PORT=8080

DB_NAME=howmuch
# Per defecte s'usa root perquè el volum de MariaDB ja existent també és root.
# En producció es pot canviar a un usuari no-root i recrear el volum.
DB_USER=root
DB_PASSWORD=canvia-aixo
DB_ROOT_PASSWORD=canvia-aixo

# Secrets compartits entre serveis (JWT i rutes /internal)
AUTH_SECRET=canvia-aquest-valor-per-un-secret-llarg-i-aleatori
INTERNAL_SECRET=canvia-aquest-valor-per-un-secret-llarg-i-aleatori

# Correu (opcional: si no es configura, el codi de verificació surt per consola)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
